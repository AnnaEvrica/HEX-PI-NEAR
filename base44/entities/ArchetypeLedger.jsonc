{
  "name": "ArchetypeLedger",
  "type": "object",
  "properties": {
    "ticker": {
      "type": "string",
      "description": "Asset whose lived archetype counts this row holds"
    },
    "counts": {
      "type": "string",
      "description": "JSON-encoded learned ledger { global, states, families, archetypes } \u2014 outcome counts only, never confidence"
    },
    "bars_learned": {
      "type": "number",
      "default": 0,
      "description": "Held-out bars this ledger was accumulated over"
    },
    "entries": {
      "type": "number",
      "default": 0,
      "description": "Number of distinct archetype keys retained after top-N pruning"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "When this asset's ledger was last written"
    }
  },
  "required": [
    "ticker",
    "counts"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}