{
  "name": "Asset",
  "type": "object",
  "properties": {
    "ticker": {
      "type": "string",
      "description": "Asset ticker symbol (e.g. BTC, ETH, SPY)"
    },
    "name": {
      "type": "string",
      "description": "Full name of the asset"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "equity",
        "crypto",
        "fixed_income",
        "commodity",
        "fx",
        "alternative"
      ],
      "description": "Asset class category"
    },
    "current_weight": {
      "type": "number",
      "description": "Current portfolio weight (0-1)"
    },
    "target_weight": {
      "type": "number",
      "description": "Target portfolio weight from HEX6 engine (0-1)"
    },
    "market_state": {
      "type": "string",
      "enum": [
        "BULL",
        "BEAR",
        "LATERAL",
        "VOLATILE",
        "SILENCE"
      ],
      "description": "Last detected market state for this asset"
    },
    "last_rebalance": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last rebalance"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether asset is actively governed"
    },
    "description": {
      "type": "string",
      "description": "Asset description / notes"
    }
  },
  "required": [
    "ticker",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}