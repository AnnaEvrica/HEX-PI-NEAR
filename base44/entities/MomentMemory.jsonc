{
  "name": "MomentMemory",
  "type": "object",
  "description": "The Memory Library: one row per series per finished bar, appended and never changed. The moment as it was perceived, and how it stood against the moments before it. Holds no personal data.",
  "properties": {
    "moment_id": { "type": "string", "description": "Unique: series | date | signature version" },
    "run_id": { "type": "string", "description": "The nightly run that recorded it" },
    "series_id": { "type": "string", "description": "The series (a ticker)" },
    "as_of": { "type": "string", "description": "Date of the last finished bar, YYYY-MM-DD" },
    "as_of_day": { "type": "number", "description": "The same as days since 1970-01-01" },
    "seq": { "type": "number", "description": "Ordinal of the moment in its series: 1 for the first" },
    "tier": { "type": "number", "description": "How many times seq divides by two. Tier j and above keeps one moment in 2^j, evenly over the whole past, so the reference can be read without reading the library" },
    "bar_time": { "type": "number", "description": "Timestamp (seconds) of that bar: when the observation was acquired" },
    "step": { "type": "number", "description": "Index of the observation in the series" },
    "samples": { "type": "number", "description": "Observations in the window" },
    "environment": { "type": "string", "description": "Where the channels come from" },
    "provenance": { "type": "string", "description": "Source of the observations" },
    "deployment": { "type": "string", "enum": ["production", "test"], "description": "Which app wrote the row: production (hex6-ble.com) or the test app" },
    "channels": { "type": "string", "description": "Neighbours that could be measured, comma separated" },
    "signature": { "type": "string", "description": "JSON. Sigma = (X, G, Phi, U): state, harmony, leadership, persistence, rhythm, and the precision of each. No novelty inside" },
    "signature_hash": { "type": "string", "description": "SHA-256 of the signature" },
    "intrinsic_tail": { "type": "number", "description": "Novelty: tail probability of the most unusual channel move" },
    "joint_tail": { "type": "number", "description": "Novelty: tail probability of the joint configuration" },
    "relational_surprisal": { "type": "number", "description": "Novelty: nats by which the configuration is more surprising than its parts" },
    "individuality": { "type": "number", "description": "Resolvable steps to the nearest earlier moment in the reference: about 1 for the same configuration seen again through measurement noise. Empty when there is none to compare with" },
    "nearest_prior": { "type": "string", "description": "moment_id of that nearest earlier moment" },
    "reference_count": { "type": "number", "description": "Earlier moments it was compared with" },
    "reference_full": { "type": "boolean", "description": "Whether the reference had reached its fixed size" },
    "incomparable": { "type": "number", "description": "Earlier moments that could not be compared" },
    "affinity_nearest": { "type": "number", "description": "exp(-d^2/2) to the nearest earlier moment" },
    "affinity_median": { "type": "number", "description": "Median affinity over the reference" },
    "affinity_q25": { "type": "number", "description": "Lower quartile" },
    "affinity_q75": { "type": "number", "description": "Upper quartile" },
    "transition": { "type": "number", "description": "Resolvable steps from the previous moment of the series. Empty when it is missing or incomparable" },
    "transition_days": { "type": "number", "description": "Days since the previous moment" },
    "transition_rate": { "type": "number", "description": "Transition per day" },
    "previous": { "type": "string", "description": "moment_id of the previous moment" },
    "components": { "type": "string", "description": "JSON: the distance by component, for the nearest earlier moment and for the transition" },
    "cer_version": { "type": "string", "description": "CER version that perceived the moment" },
    "signature_version": { "type": "string", "description": "Definition of the signature" },
    "distance_version": { "type": "string", "description": "Definition of the distance" },
    "bandwidth_version": { "type": "string", "description": "Affinity bandwidth" },
    "metric_version": { "type": "string", "description": "Definition of the experiential measurements" }
  },
  "required": ["moment_id", "series_id", "as_of", "signature"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
