{
  "name": "MarkovTickerMemory",
  "type": "object",
  "properties": {
    "ticker": {
      "type": "string",
      "description": "Asset ticker or series identifier this matrix belongs to"
    },
    "transition_matrix": {
      "type": "string",
      "description": "JSON-encoded transition counts: { 's0->s1': count }"
    },
    "transition_rewards": {
      "type": "string",
      "description": "JSON-encoded per-transition reward stats: { 's0->s1': { sum, sum2, n } }"
    },
    "total_observations": {
      "type": "number",
      "description": "Total transitions accumulated for this ticker",
      "default": 0
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update"
    },
    "petal_distribution": {
      "type": "string",
      "description": "JSON-encoded I-Ching petal frequency: yang petal counts and yin petal counts (64 each)"
    }
  },
  "required": [
    "ticker"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}