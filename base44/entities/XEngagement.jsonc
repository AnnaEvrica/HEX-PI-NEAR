{
  "name": "XEngagement",
  "type": "object",
  "properties": {
    "tweet_id": {
      "type": "string",
      "description": "X tweet ID that was analyzed and (where supported) replied to"
    },
    "author_username": {
      "type": "string",
      "description": "Author @handle of the original tweet"
    },
    "text_snippet": {
      "type": "string",
      "description": "First 280 chars of the original tweet text"
    },
    "ticker": {
      "type": "string",
      "description": "Asset ticker identified from the tweet (e.g. BTC) or UNKNOWN"
    },
    "claim": {
      "type": "string",
      "description": "One-sentence market claim extracted from the tweet"
    },
    "actionable": {
      "type": "boolean",
      "default": false,
      "description": "Whether the tweet made a directional market claim the engine can read"
    },
    "reply_tweet_id": {
      "type": "string",
      "description": "ID of the bot's reply tweet on X, if posted"
    },
    "x_reply_text": {
      "type": "string",
      "description": "The validated reply text posted on X"
    },
    "discord_posted": {
      "type": "boolean",
      "default": false
    },
    "discord_elaboration": {
      "type": "string",
      "description": "Full elaboration + stats posted to Discord"
    },
    "probability": {
      "type": "number",
      "description": "P(next move up) from the engine (0-1)"
    },
    "predicted_direction": {
      "type": "string",
      "enum": [
        "UP",
        "DOWN",
        "FLAT"
      ],
      "description": "FLAT records a direction read that sits at its usual odds"
    },
    "status": {
      "type": "string",
      "enum": [
        "posted",
        "skipped",
        "failed"
      ],
      "default": "posted"
    },
    "skip_reason": {
      "type": "string",
      "description": "Why the tweet was skipped, if status=skipped"
    },
    "error": {
      "type": "string",
      "description": "Error message if status=failed"
    },
    "edge": {
      "type": "number",
      "description": "Distance of P(up) from the series' usual odds, in probability points (0-1). A statistic, not a confidence."
    }
  },
  "required": [
    "tweet_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
