{
  "name": "Brain",
  "type": "object",
  "properties": {
    "brain_id": {
      "type": "string",
      "description": "Unique identifier for this brain (e.g. 'seed_BTC', 'auto_001')"
    },
    "transition_matrix": {
      "type": "string",
      "description": "JSON-encoded transition counts: { 's0->s1': count }"
    },
    "transition_rewards": {
      "type": "string",
      "description": "JSON-encoded per-transition reward stats: { 's0->s1': { sum, sum2, n } }"
    },
    "count": {
      "type": "number",
      "description": "Total transitions accumulated",
      "default": 0
    },
    "series_count": {
      "type": "number",
      "description": "Number of distinct series routed to this brain",
      "default": 0
    },
    "confidence": {
      "type": "number",
      "description": "Confidence based on count: min(1, count/30)",
      "default": 0
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update"
    }
  },
  "required": [
    "brain_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}