{
  "name": "CoreNode",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Unique identifier for this concept node"
    },
    "concept": {
      "type": "string",
      "description": "The concept, fact, or entity label \u2014 neutral, never an opinion or conclusion"
    },
    "concept_type": {
      "type": "string",
      "enum": [
        "asset",
        "indicator",
        "theory",
        "event",
        "entity",
        "pattern",
        "metric",
        "concept"
      ],
      "default": "concept",
      "description": "Category of this concept"
    },
    "embedding": {
      "type": "string",
      "description": "JSON-encoded semantic embedding vector"
    },
    "metadata": {
      "type": "string",
      "description": "JSON-encoded neutral facts (never conclusions, judgments, or value)"
    },
    "source": {
      "type": "string",
      "enum": [
        "user_query",
        "market_data",
        "llm_synthesis",
        "manual",
        "feedback"
      ],
      "default": "user_query",
      "description": "Where this concept originated"
    },
    "interaction_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this concept has been encountered (neutral observation, not a ranking)"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time",
      "description": "When this concept was first observed"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "When this concept was last observed"
    }
  },
  "required": [
    "node_id",
    "concept"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}