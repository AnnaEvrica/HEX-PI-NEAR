{
  "name": "EngineStatus",
  "type": "object",
  "properties": {
    "read": {
      "type": "string",
      "enum": [
        "MOVE",
        "RANGE"
      ],
      "description": "One row per read"
    },
    "live_engine": {
      "type": "string",
      "enum": [
        "state-6.2",
        "state-6.5"
      ],
      "description": "The engine shown for this read"
    },
    "paired_calls": {
      "type": "number",
      "description": "Calls scored for both engines on the same series and day"
    },
    "paired_days": {
      "type": "number",
      "description": "Distinct days those calls span"
    },
    "gain": {
      "type": "number",
      "description": "Mean closeness of 6.5 minus 6.2 on the same calls. Positive: 6.5 came closer"
    },
    "gain_low": {
      "type": "number",
      "description": "Lower end of the 95% interval, by day"
    },
    "gain_high": {
      "type": "number",
      "description": "Upper end of the 95% interval, by day"
    },
    "hit_control": {
      "type": "number",
      "description": "Share of 6.2 calls right on the paired calls (0-1)"
    },
    "hit_candidate": {
      "type": "number",
      "description": "Share of 6.5 calls right on the paired calls (0-1)"
    },
    "hit_baseline": {
      "type": "number",
      "description": "Share right for the baseline rule on the same calls (0-1)"
    },
    "stated_control": {
      "type": "number",
      "description": "Mean probability 6.2 stated for the side it called"
    },
    "stated_candidate": {
      "type": "number",
      "description": "Mean probability 6.5 stated for the side it called"
    },
    "progress_control": {
      "type": "number",
      "description": "6.2: mean reward per call. Reward is progress against its own record, never negative"
    },
    "progress_candidate": {
      "type": "number",
      "description": "6.5: the same"
    },
    "lesson_control": {
      "type": "number",
      "description": "6.2: mean shortfall per call against its own record. Analysis only"
    },
    "lesson_candidate": {
      "type": "number",
      "description": "6.5: the same"
    },
    "reasons_control": {
      "type": "object",
      "description": "6.2: misses by reason over the whole record",
      "additionalProperties": true
    },
    "reasons_candidate": {
      "type": "object",
      "description": "6.5: the same",
      "additionalProperties": true
    },
    "decision": {
      "type": "string",
      "enum": [
        "hold",
        "promote",
        "demote"
      ],
      "description": "What the last nightly run decided"
    },
    "reason": {
      "type": "string",
      "description": "The decision in words"
    },
    "tally": {
      "type": "string",
      "description": "JSON: running sums over every settled day, so each decision rests on the whole record"
    },
    "calibration": {
      "type": "string",
      "description": "JSON: pooled map for 6.5 on this read, from the strength it stated to how often such calls were right. Applied to strength only; never changes a call"
    },
    "calibration_steps": {
      "type": "number",
      "description": "Scored steps the map was fitted on"
    },
    "promoted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When 6.5 was last promoted for this read"
    },
    "engine_version": {
      "type": "string",
      "description": "Release that wrote this row"
    }
  },
  "required": [
    "read",
    "live_engine"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
