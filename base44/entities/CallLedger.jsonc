{
  "name": "CallLedger",
  "type": "object",
  "properties": {
    "series_id": {
      "type": "string",
      "description": "The series the call was made on (a ticker)"
    },
    "read": {
      "type": "string",
      "enum": [
        "MOVE",
        "RANGE"
      ],
      "description": "MOVE: next close higher. RANGE: next change larger than usual"
    },
    "engine": {
      "type": "string",
      "enum": [
        "state-6.5",
        "hex-7.0"
      ],
      "description": "Which engine made the call"
    },
    "call_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the last finished bar the call was made from"
    },
    "bar_ts": {
      "type": "number",
      "description": "Timestamp (seconds) of that bar"
    },
    "last_close": {
      "type": "number",
      "description": "Close of that bar"
    },
    "threshold": {
      "type": "number",
      "description": "RANGE only: the change size above which the event counts, fixed at call time"
    },
    "baseline": {
      "type": "number",
      "description": "The baseline probability (usual odds) at call time (0-1)"
    },
    "probability": {
      "type": "number",
      "description": "The engine's probability at call time (0-1)"
    },
    "raw": {
      "type": "number",
      "description": "The engine's own probability before its strength is restated"
    },
    "views": {
      "type": "string",
      "description": "JSON, written before the outcome: what each part of the engine's memory said on its own, and how much it was trusted"
    },
    "learned": {
      "type": "string",
      "description": "7.0 only. JSON, written before the outcome: the coefficients it had learned on this series and the share of the call held by the null and by each of its models (three shares; four when the series carried dates and the clock took part)"
    },
    "shown": {
      "type": "boolean",
      "default": false,
      "description": "Whether this engine was the one shown for this read"
    },
    "source": {
      "type": "string",
      "enum": [
        "nightly",
        "chat",
        "signal"
      ],
      "description": "What produced the call"
    },
    "made_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call was written"
    },
    "engine_version": {
      "type": "string",
      "description": "Release that made the call"
    },
    "deployment": {
      "type": "string",
      "enum": [
        "production",
        "test"
      ],
      "description": "Which app wrote the row: production (hex6-ble.com) or the test app"
    },
    "scored": {
      "type": "boolean",
      "default": false,
      "description": "Whether the outcome is known"
    },
    "outcome": {
      "type": "number",
      "description": "1 if the event happened, 0 if not"
    },
    "log_score": {
      "type": "number",
      "description": "ln of the probability given to what happened"
    },
    "info_gain": {
      "type": "number",
      "description": "Information gain over the null, in nats: ln p(outcome) - ln null(outcome). Divide by ln 2 for bits. The measure every decision rests on"
    },
    "scored_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was scored"
    },
    "closeness": {
      "type": "number",
      "description": "How near the engine's probability came to what happened: 1 - (probability - outcome)^2"
    },
    "closeness_baseline": {
      "type": "number",
      "description": "The same for the baseline"
    },
    "reward": {
      "type": "number",
      "description": "Progress against the same engine's record on this series and read (average closeness of its earlier calls), when the call came closer; otherwise 0. Never negative"
    },
    "lesson": {
      "type": "number",
      "description": "How far the call fell short of that record, when it did. Analysis only: never subtracted from anything"
    },
    "reason": {
      "type": "string",
      "description": "Why the call missed, found from the views: structure, change, blip, outvoted or unseen. Empty when the call was on the right side"
    },
    "part_baseline": {
      "type": "number",
      "description": "What the series' own record (the null) added to closeness over a coin flip"
    },
    "part_structure": {
      "type": "number",
      "description": "What HEX added to that"
    },
    "part_strength": {
      "type": "number",
      "description": "What restating the strength added. closeness = 0.75 + the three parts"
    },
    "record_calls": {
      "type": "number",
      "description": "The engine's scored calls on this series and read, including this one"
    },
    "record_closeness": {
      "type": "number",
      "description": "Their average closeness: the record the next call is measured against"
    }
  },
  "required": [
    "series_id",
    "read",
    "engine",
    "call_date",
    "baseline",
    "probability"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
