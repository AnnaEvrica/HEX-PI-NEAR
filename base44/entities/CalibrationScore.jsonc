{
  "name": "CalibrationScore",
  "type": "object",
  "properties": {
    "score_date": {
      "type": "string",
      "format": "date",
      "description": "Date this calibration was computed for"
    },
    "ticker": {
      "type": "string",
      "description": "Ticker scored (or 'GLOBAL' for aggregate)"
    },
    "predictions_evaluated": {
      "type": "number",
      "description": "Number of logged direction reads scored so far"
    },
    "directional_accuracy": {
      "type": "number",
      "description": "Share of scored direction reads that matched the next daily close (0-1)"
    },
    "avg_realized_return": {
      "type": "number",
      "description": "Average log change between entry and scoring close across scored reads"
    },
    "calibration_grade": {
      "type": "string",
      "enum": [
        "INSUFFICIENT_DATA",
        "UNGRADED",
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "description": "INSUFFICIENT_DATA below 100 scored reads, otherwise UNGRADED. Letter values exist only on rows written before engine 6.1."
    },
    "notes": {
      "type": "string",
      "description": "Human-readable summary"
    }
  },
  "required": [
    "score_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
