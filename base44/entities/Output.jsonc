{
  "name": "Output",
  "type": "object",
  "properties": {
    "output_id": {
      "type": "string",
      "description": "Unique identifier for this prediction record"
    },
    "series_id": {
      "type": "string",
      "description": "Series this output belongs to"
    },
    "brain_id": {
      "type": "string",
      "description": "Brain that produced this prediction"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the prediction was made"
    },
    "current_state": {
      "type": "number",
      "description": "6-bit state at time of prediction (0-63)"
    },
    "predicted_distribution": {
      "type": "string",
      "description": "JSON-encoded next-state probabilities: { 'state': probability }"
    },
    "direction": {
      "type": "string",
      "enum": [
        "UP",
        "DOWN",
        "FLAT",
        "UNKNOWN"
      ],
      "description": "Predicted directional bias"
    },
    "confidence": {
      "type": "number",
      "description": "Probability mass behind the predicted direction"
    },
    "expected_return": {
      "type": "number",
      "description": "Expected return from transition rewards"
    },
    "actual_outcome": {
      "type": "number",
      "description": "Realized next-step return (filled when known)"
    },
    "error": {
      "type": "number",
      "description": "Difference between expected and actual"
    },
    "calibration_score": {
      "type": "number",
      "description": "Per-output calibration: 1 if direction matched, 0 if not, null if unknown"
    }
  },
  "required": [
    "output_id",
    "series_id",
    "brain_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}