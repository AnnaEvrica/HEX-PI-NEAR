{
  "name": "Routing",
  "type": "object",
  "properties": {
    "series_id": {
      "type": "string",
      "description": "Series being routed"
    },
    "brain_id": {
      "type": "string",
      "description": "Brain assigned to this series"
    },
    "distance": {
      "type": "number",
      "description": "KL divergence between series transition profile and brain (in nats)"
    },
    "confidence": {
      "type": "number",
      "description": "1 - (distance / threshold), clamped [0,1]"
    },
    "threshold_at_routing": {
      "type": "number",
      "description": "EWMA threshold value at the time of this routing decision"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of routing decision"
    }
  },
  "required": [
    "series_id",
    "brain_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}