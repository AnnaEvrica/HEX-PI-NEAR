{
  "name": "CognitiveState",
  "type": "object",
  "properties": {
    "state_id": {
      "type": "string",
      "description": "Unique identifier for this cognitive state packet"
    },
    "thinking_mode": {
      "type": "string",
      "enum": [
        "reason",
        "understand"
      ],
      "description": "Always \"reason\" since engine 6.1"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user whose query produced this cognitive state"
    },
    "query": {
      "type": "string",
      "description": "The user query that triggered this thinking cycle"
    },
    "probability": {
      "type": "number",
      "description": "P(next move up) stated for the series (0-1)"
    },
    "resonance": {
      "type": "number",
      "description": "Cadence regularity of the person's messages (0-1); null when not computed"
    },
    "predicted_direction": {
      "type": "string",
      "enum": [
        "UP",
        "DOWN"
      ],
      "description": "The side P(up) favours"
    },
    "base_rate": {
      "type": "number",
      "description": "The series' usual odds of an up move (0-1)"
    },
    "edge": {
      "type": "number",
      "description": "Distance of P(up) from the series' usual odds, in probability points (0-1). A statistic, not a confidence."
    }
  },
  "required": [
    "state_id",
    "thinking_mode"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
