{
  "name": "UserConversationMemory",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user this memory belongs to"
    },
    "memory_summary": {
      "type": "string",
      "description": "Rolling compressed summary of all past conversations with this user"
    },
    "topics_discussed": {
      "type": "string",
      "description": "Comma-separated list of key topics, assets, and themes the user has explored"
    },
    "user_style": {
      "type": "string",
      "description": "Observed communication style, sophistication level, and preferences of this user"
    },
    "last_conversation_snippet": {
      "type": "string",
      "description": "Last few exchanges to enable seamless continuation"
    },
    "calibration_state": {
      "type": "string",
      "description": "Per-user nightly calibration digest (engine grade, cycle count, avg confidence, dominant lean) written by the nightly calibration job"
    },
    "total_conversations": {
      "type": "number",
      "description": "Total number of conversation turns remembered"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}