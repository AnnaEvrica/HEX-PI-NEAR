{
  "name": "UserConversationMemory",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user this memory belongs to"
    },
    "memory_summary": {
      "type": "string",
      "description": "Rolling compressed summary of all past conversations with this user"
    },
    "topics_discussed": {
      "type": "string",
      "description": "Comma-separated list of key topics, assets, and themes the user has explored"
    },
    "user_style": {
      "type": "string",
      "description": "Observed communication style, sophistication level, and preferences of this user"
    },
    "last_conversation_snippet": {
      "type": "string",
      "description": "Last few exchanges to enable seamless continuation"
    },
    "total_conversations": {
      "type": "number",
      "description": "Total number of conversation turns remembered"
    },
    "boundary_warning_count": {
      "type": "number",
      "description": "Running count of boundary warnings issued to this user since the last escalation (0 after escalation)",
      "default": 0
    },
    "last_warning_reason": {
      "type": "string",
      "description": "Short reason phrase of the most recent boundary warning (emitted by the persona via BOUNDARY_SIGNAL)"
    },
    "last_warning_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent boundary warning was issued"
    },
    "escalation_count": {
      "type": "number",
      "description": "How many times this user has crossed the 3-warning threshold (incremented on each mediation escalation)",
      "default": 0
    },
    "last_escalation_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent mediation escalation was triggered"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
