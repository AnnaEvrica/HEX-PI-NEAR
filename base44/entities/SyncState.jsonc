{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "sync_name": {
      "type": "string",
      "description": "Unique identifier for this sync job (e.g. 'engine_runs_to_postgres')"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "success",
        "error"
      ],
      "default": "idle",
      "description": "Current status of the sync job"
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last sync attempt started"
    },
    "last_success_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last successful sync completed"
    },
    "last_synced_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Watermark \u2014 only fetch engine runs newer than this on the next run"
    },
    "rows_last_run": {
      "type": "number",
      "description": "Number of EngineRunLog records synced in the last run",
      "default": 0
    },
    "rows_total": {
      "type": "number",
      "description": "Cumulative rows synced since inception",
      "default": 0
    },
    "last_error": {
      "type": "string",
      "description": "Most recent error message, if any"
    },
    "lock_acquired_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current run acquired the lock (used to detect stale locks)"
    }
  },
  "required": [
    "sync_name"
  ]
}