{
  "description": "Replays past HEX6 engine outputs against realized returns each night to compute calibration scores per ticker.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hex6_nightly_calibration_scorer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nightlyCalibration",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "HEX6 Nightly Calibration Scorer",
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "nightly-calibration"
  }
}