{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "asi_spine_drift_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "spineAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "Posts a Discord alert when a verdict is anchored with disagreement_flag=true.",
  "name": "ASI Spine \u2014 drift alert",
  "trigger": {
    "condition": "${ (.trigger.data.disagreement_flag == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "VerdictSpine"
    }
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "spine-alert"
  }
}